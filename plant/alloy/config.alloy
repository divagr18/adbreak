// Grafana Alloy: ships the plant's metrics and logs to Grafana Cloud.
//
// Scrape targets are static rather than docker-discovered: the service list is
// fixed and known, so a static list keeps the scrape config deterministic and
// makes a missing target an obvious failure instead of a silent absence.

prometheus.scrape "plant" {
  targets = [
    {"__address__" = "playout:3000",          "component" = "playout"},
    {"__address__" = "packager:3000",         "component" = "packager"},
    {"__address__" = "ads:3000",              "component" = "ads"},
    {"__address__" = "ssai:3000",             "component" = "ssai"},
    {"__address__" = "edge:3000",             "component" = "edge"},
    {"__address__" = "player-fleet:3000",     "component" = "player-fleet"},
    {"__address__" = "beacon-collector:3000", "component" = "beacon-collector"},
    {"__address__" = "chaos-injector:3000",   "component" = "chaos-injector"},
    {"__address__" = "agent:3000",            "component" = "agent"},
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
  metrics_path    = "/metrics"

  // Exemplars ride the OpenMetrics exposition format only.
  enable_protobuf_negotiation = false
  scrape_protocols            = ["OpenMetricsText1.0.0", "OpenMetricsText0.0.1", "PrometheusText0.0.4"]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_PROM_URL")
    basic_auth {
      username = sys.env("GC_PROM_USER")
      password = sys.env("GC_TOKEN")
    }
    send_exemplars = true
  }
  // `env` keeps two plants from colliding in one Grafana Cloud stack. Without
  // it the local plant and the deployed VM ship identical metric names with
  // identical labels, Prometheus treats them as ONE series with samples
  // interleaved from two sources, and every rate over that series is nonsense -
  // increase() over 10m read 649,890 where one plant produces about 2,000.
  external_labels = {
    plant = "adbreak",
    env   = sys.env("ADBREAK_ENV") != "" ? sys.env("ADBREAK_ENV") : "local",
  }
}

// ---- logs ------------------------------------------------------------------
// Every service already writes structured JSON lines carrying avail_id,
// session_id and trace_id. Labels stay low-cardinality (component/severity);
// everything else stays a field, per the telemetry contract.

discovery.docker "plant" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "plant" {
  targets = discovery.docker.plant.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "component"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "adbreak"
    action        = "keep"
  }
  // Only the application services log structured JSON. nginx and redis emit
  // their own formats at high volume, which is cost without signal here.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "playout|packager|ads|ssai|edge|player-fleet|beacon-collector|chaos-injector|agent"
    action        = "keep"
  }
}

loki.source.docker "plant" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.plant.output
  relabel_rules = discovery.relabel.plant.rules
  forward_to    = [loki.process.plant.receiver]
}

loki.process "plant" {
  // Lift severity out of the JSON so it can be a label without exploding
  // cardinality; avail_id and friends stay in the line as fields.
  stage.json {
    expressions = {severity = "severity"}
  }
  stage.labels {
    values = {severity = ""}
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_LOKI_URL")
    basic_auth {
      username = sys.env("GC_LOKI_USER")
      password = sys.env("GC_TOKEN")
    }
  }
  external_labels = {
    plant = "adbreak",
  }
}
