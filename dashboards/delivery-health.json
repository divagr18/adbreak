{
  "uid": "adbreak-delivery",
  "title": "AdBreak — Delivery Health",
  "description": "The conventional streaming NOC view: is the stream up and playing? This dashboard contains no revenue signal by design — it is what stays green while the money burns.",
  "tags": ["adbreak", "delivery"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CDN availability",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(adbreak_cdn_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(adbreak_cdn_requests_total[5m])), 1)",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CDN 5xx (last 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(adbreak_cdn_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active player sessions",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A", "expr": "sum(adbreak_fleet_sessions)", "legendFormat": "sessions" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stitch errors (last 5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(adbreak_stitch_errors_total[5m])) or vector(0)",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CDN requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(adbreak_cdn_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by PoP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pop) (rate(adbreak_cdn_requests_total[1m]))",
          "legendFormat": "{{pop}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Manifest latency p95 by PoP",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, pop) (rate(adbreak_manifest_latency_seconds_bucket[5m])))",
          "legendFormat": "{{pop}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Player-side fetch errors",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(adbreak_fleet_fetch_errors_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Signal chain — avails signaled vs manifested",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(adbreak_avail_signaled_total[5m]))",
          "legendFormat": "signaled"
        },
        {
          "refId": "B",
          "expr": "sum(increase(adbreak_avail_manifested_total[5m]))",
          "legendFormat": "manifested"
        }
      ]
    }
  ]
}
